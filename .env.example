# API privada do catálogo/estoque. Nunca exponha estes valores no frontend.
LEVELKEYS_API_BASE_URL=https://levelkeys.online/api/v1
LEVELKEYS_API_KEY=cole_sua_chave_levelkeys_aqui

# Mercado Pago: use o Access Token de produção no backend.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-cole_seu_access_token_aqui
MERCADOPAGO_PUBLIC_KEY=APP_USR-cole_sua_public_key_aqui

# URL pública que receberá as notificações de pagamento.
MERCADOPAGO_WEBHOOK_URL=https://seu-dominio.com/api/payments/webhook
PUBLIC_URL=https://seu-dominio.com
PORT=4173
APP_URL=https://seu-dominio.com

# SMTP para envio das Steam keys por e-mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=natangameytb@gmail.com
SMTP_PASS=0023
SMTP_FROM=seu_email@gmail.com

# Ambiente da aplicação: test ou production
NODE_ENV=development